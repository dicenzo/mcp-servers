{
  "name": "mcp-graphics-integration-tests",
  "version": "1.0.0",
  "description": "Integration testing framework for MCP Graphics Toolset",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "integration-testing",
    "graphics",
    "cross-server",
    "performance"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:performance": "jest --testPathPattern=performance",
    "test:workflows": "jest --testPathPattern=workflows",
    "test:parallel": "jest --maxWorkers=4",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "benchmark": "tsx src/benchmarks/run-all.ts",
    "setup": "tsx src/scripts/setup-test-env.ts",
    "validate": "tsx src/scripts/validate-setup.ts",
    "cleanup": "tsx src/scripts/cleanup-test-env.ts",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/test-runner.ts",
    "servers:start": "tsx src/scripts/start-servers.ts",
    "servers:stop": "tsx src/scripts/stop-servers.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.2.0",
    "cross-spawn": "^7.0.3",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "p-limit": "^4.0.0",
    "p-retry": "^6.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Tony DiCenzo"
}
