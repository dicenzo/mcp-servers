{
  "name": "mcp-templates",
  "version": "1.0.0",
  "description": "MCP Server for design template management, rendering, and multi-format export",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "mcp",
    "templates",
    "design",
    "graphics",
    "rendering",
    "export"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark": "tsx tests/benchmark.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chroma-js": "^2.4.2",
    "dotenv": "^16.4.5",
    "handlebars": "^4.7.10",
    "jsdom": "^26.1.0",
    "mustache": "^4.2.0",
    "puppeteer": "^23.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@types/mustache": "^4.2.5",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "Tony DiCenzo"
}
