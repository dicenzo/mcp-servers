# Web search providers for the web.search tool. Set at least one.
# They are tried in this order: Tavily, then SerpAPI, then Brave.
TAVILY_API_KEY=
SERPAPI_KEY=
BRAVE_API_KEY=

# Optional: directory containing Markdown templates (*.md) served by
# templates.get and the templates:// resources.
# Defaults to ../templates relative to the server's working directory.
TEMPLATES_DIR=
