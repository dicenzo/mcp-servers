{
  "name": "mcp-graphics-type",
  "version": "1.0.0",
  "description": "MCP Server for typography, font processing, and text shaping with advanced Unicode support",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "mcp",
    "typography",
    "fonts",
    "text-shaping",
    "unicode",
    "opentype",
    "subsetting"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark": "tsx tests/benchmark.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "opentype.js": "^1.3.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.3.0",
    "@types/opentype.js": "^1.3.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Tony DiCenzo"
}
